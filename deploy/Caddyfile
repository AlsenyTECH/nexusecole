# NexusEcole — serveur web de production (Caddy)
# - HTTPS automatique pour chaque école (certificat obtenu au premier accès),
#   uniquement pour les domaines déclarés dans la console (voir /interne/tls-autorise)
# - /api/* → Django (gunicorn) ; le reste → l'interface React (fichiers statiques)
{
	email {$ACME_EMAIL}
	{$CADDY_OPTIONS_GLOBALES}
	on_demand_tls {
		ask http://backend:8000/interne/tls-autorise
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(self), geolocation=(), microphone=()"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	# Fichiers versionnés (nom avec empreinte) : cache long
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Application monopage : toute autre adresse renvoie index.html (jamais mis en cache)
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}

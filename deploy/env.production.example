# Copier en .env à la racine du projet sur le serveur, puis remplir.
# Générer chaque secret avec : openssl rand -hex 32
# (hexadécimal : pas de caractères comme / + = qui casseraient l'adresse de la base)

# Domaine : les écoles seront sur <ecole>.BASE_DOMAIN, la console sur PUBLIC_DOMAIN
BASE_DOMAIN=nexusecole.sn
PUBLIC_DOMAIN=admin.nexusecole.sn
# '*' est sûr ici : seules les écoles déclarées sont servies (Caddy + django-tenants),
# et cela permettra plus tard aux écoles d'utiliser leur propre domaine.
ALLOWED_HOSTS=*

# Secrets — à générer, à ne jamais partager ni committer
SECRET_KEY=
JWT_SIGNING_KEY=
# Clé de signature des bulletins : NE JAMAIS LA CHANGER (sinon les bulletins émis ne se vérifient plus)
BULLETIN_SIGNING_SECRET=
POSTGRES_PASSWORD=

# Adresse e-mail pour Let's Encrypt (alertes d'expiration des certificats)
ACME_EMAIL=

# Nombre de processus de l'API (2 × cœurs + 1 est une bonne base)
GUNICORN_WORKERS=3
